APP_ENV=local

# Jika menggunakan llm hosted gunakan ini
LLM_PROVIDER=hosted
LLM_MODEL=openrouter/free
HOSTED_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Jika menggunakan ollama local gunakan ini
OLLAMA_BASE_URL=http://127.0.0.1:11434

# API KEY
API_ACCESS_TOKEN=

# Embedding lokal menggunakan ONNX Runtime CPU; dokumen tidak dikirim ke layanan embedding.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE=.cache/embeddings

MIN_SIMILARITY=0.35
MAX_CONCURRENT=1
