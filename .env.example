APP_ENV=local

# Jika menggunakan llm hosted gunakan ini
LLM_PROVIDER=hosted
LLM_MODEL=openrouter/free
HOSTED_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Jika menggunakan ollama local gunakan ini
OLLAMA_BASE_URL=http://127.0.0.1:11434

# API KEY
API_ACCESS_TOKEN=

# Pencarian ringan: TF-IDF lokal + ChromaDB, tanpa unduhan model embedding.
# Tidak mengirim dokumen ke API embedding. Hosted LLM tetap menerima konteks jawaban.
# EMBEDDING_MODEL, EMBEDDING_CACHE, MIN_SIMILARITY dari versi lama tidak dipakai lagi.
RETRIEVAL_MIN_SCORE=0.12
MAX_CONCURRENT=1
